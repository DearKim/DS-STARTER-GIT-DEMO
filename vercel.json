{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm typecheck && pnpm ds:guard && pnpm web:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/detail",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    }
  ]
}
